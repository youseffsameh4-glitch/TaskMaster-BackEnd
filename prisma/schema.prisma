datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// users table

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  password  String
// we tell prisma that one user is attached to a list of todos

  todos     Todo[]
}

// Todo table

model Todo {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  status        String    @default("ongoing")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        Int
  //this is how we link both tables to eachother

  user          User      @relation(fields:[userId], references: [id], onDelete:Cascade)
}
